# ── Secrets — NEVER commit these ─────────────────────────────────────────────
data/runtime-config.php
data/*.lock
data/*.json

# ── Temp / scratch files ──────────────────────────────────────────────────────
.tmp_*.php
.tmp_*.html

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Local Supabase backups (per-environment) ───────────────────────────────────
.supabase-backups/

# Admin uploads are runtime data. New files live outside the Git checkout in
# production, and legacy/local copies must never be committed accidentally.
assets/uploads/admin/*
